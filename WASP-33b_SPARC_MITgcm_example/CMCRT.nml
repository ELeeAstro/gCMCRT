&main

exp_name = 'SPARC-MITgcm'
xper = '3D_sph_em'
! Set xper = '3D_sph_trans' to run transmission.
! Set xper = '3D_sph_trans_lc' to run the primary-transit light-curve block below.
! Set xper = '3D_sph_alb' and do_scat_loop = .True. to run the albedo block.

oneD = .False.
threeD = .True.

do_moments = .False.
do_images = .False.
do_cf = .False.

inc_ck = .True.
inc_lbl = .False.
inc_CIA = .True.
inc_Ray = .True.
inc_cld = .False.
inc_xsec = .False.

do_scat_loop = .False.
do_g_bias = .True.
wght_deg = .False.
do_BB_band = .False.
do_surf = .False.
T_surf = 0.0
emis_surf = 0.0
alb_surf = 0.0

lbl = .False.
ck = .True.

LHS = .False.
random_seed = 12345

! Wind parameters for hi-res los velocity
doppler_on = .False.
winds_on = .False.
rotation_on = .False.
orbit_on = .False.
systemic_velocity = 0.0 ! Systematic velocity (km s-1)

xpix = 300
ypix = 300

Draine_alp = 0.5

do_LD = .False.
ilimb = 2
LD_c = 0.246, 0.252, 0.0, 0.0


! Emission phase-curve/eclipsing controls. For a single-view emission run set
! do_phase = .False.; for phase curves set do_phase = .True.; for secondary
! eclipse/occultation sampling set both do_phase and do_eclipse .True.
do_phase = .True.
n_phase = 16
do_eclipse = .True.
n_ecl = 10
Rs = 1.444
ecc = 0.0
sm_ax = 0.0239
inc = 86.63
orbital_period = 1.21987

/

&sph_3D_em

Nph_tot = 10240000
! Set false to restore the legacy scalar-atomic accumulator for A/B testing.
use_block_accum = .True.
s_wl = 1
n_wl = 503
pl = 0.51
pc = 0.39
sc = 1.0
iscat = 6
n_theta = 31
n_phi = 65
n_lay = 53
viewthet = 90.0
viewphi = 0.0
xi_emb = 0.99

/

&sph_3D_trans

Nph = 1024000
! Set false to restore the legacy scalar-atomic accumulator for A/B testing.
use_block_accum = .True.
s_wl = 1
n_wl = 503
pl = 0.51
pc = 0.39
sc = 1.0
iscat = 6
n_theta = 31
n_phi = 65
n_lay = 53
viewthet = 90.0
viewphi = 180.0
nb_cf = 301

/

&sph_3D_alb

Nph = 1024000
! Set false to restore the legacy scalar-atomic accumulator for A/B testing.
use_block_accum = .True.
s_wl = 1
n_wl = 503
pl = 0.51
pc = 0.39
sc = 1.0
iscat = 3
n_theta = 31
n_phi = 65
n_lay = 53
viewthet = 90.0
viewphi = 0.0, 22.5, 45.0, 67.5, 90.0, 112.5, 135.0, 157.5,
          180.0, 202.5, 225.0, 247.5, 270.0, 292.5, 315.0, 337.5

/

&sph_3D_trans_lc

! Transit light-curve settings. To use this block, set xper = '3D_sph_trans_lc'
! in &main. n_trans mirrors n_phase + n_ecl above.
Nph = 1024000
! Set false to restore the legacy scalar-atomic accumulator for A/B testing.
use_block_accum = .True.
s_wl = 1
n_wl = 503
n_trans = 26
n_ingress = 10
pl = 0.51
pc = 0.39
sc = 1.0
iscat = 6
n_theta = 31
n_phi = 65
n_lay = 53

/
