&main

exp_name = 'FMS'
xper = '3D_sph_trans_lc'
! Set xper = '3D_sph_trans_lc' to run the primary-transit light-curve block below.
! Set xper = '3D_sph_em' and do_trans = .False. to run the emission block.
do_trans = .True.

oneD = .False.
threeD = .True.

do_moments = .False.
do_images = .False.
do_cf = .False.

inc_ck = .True.
inc_lbl = .False.
inc_CIA = .True.
inc_Ray = .True.
inc_cld = .False.
inc_xsec = .False.

do_scat_loop = .False.
do_g_bias = .True.
wght_deg = .False.
do_BB_band = .False.
do_surf = .False.
T_surf = 0.0
emis_surf = 0.0
alb_surf = 0.0

lbl = .False.
ck = .True.

LHS = .False.

! Wind parameters for hi-res los velocity
doppler_on = .False.
winds_on = .False.
rotation_on = .False.
orbit_on = .False.
systemic_velocity = 0.0    ! Systematic velocity (km s-1)


xpix = 200
ypix = 200

do_Draine = .False.
Draine_alp = 0.5


do_LD = .False.
ilimb = 2
LD_c = 0.171, 0.211, 0.0, 0.0

orbital_period = 4.055 ! orbital period (days)
sm_ax = 0.0486             ! semi-major axis (AU)
Rs = 0.895
inc = 87.7369
ecc = 0.0
phase = 0.0

! Emission phase-curve/eclipsing controls. These are off for the default
! transmission-spectrum run. For a phase curve set do_phase = .True.; for
! secondary eclipse/occultation sampling set both do_phase and do_eclipse .True.
do_phase = .False.
do_eclipse = .False.
n_phase = 16
n_ecl = 10

/

&sph_3D_em

! Dormant WASP-39b emission setup. To use this block set xper = '3D_sph_em'
! and do_trans = .False. in &main. With do_phase = .False., viewphi/viewthet
! define one view. With do_phase = .True., viewphi is generated from n_phase.
Nph_tot = 1024000
s_wl = 1
n_wl = 503
pl = 0.51
pc = 0.39
sc = 1.0
iscat = 6
n_theta = 97
n_phi = 193
n_lay = 54
viewthet = 87.83
viewphi = 0.0
xi_emb = 0.99

/

&sph_3D_trans

Nph = 1024000
s_wl = 1
n_wl = 503
pl = 0.51
pc = 0.39
sc = 1.0
iscat = 6
n_theta = 97
n_phi = 193
n_lay = 54
viewthet = 90.0
viewphi = 180.0
nb_cf = 301

/

&sph_3D_trans_lc

! Transit light-curve settings. To use this block, set xper = '3D_sph_trans_lc'
! in &main. n_trans mirrors n_phase + n_ecl above for comparable sampling.
Nph = 1024000
s_wl = 1
n_wl = 503
n_trans = 26
n_ingress = 10
pl = 0.51
pc = 0.39
sc = 1.0
iscat = 6
n_theta = 97
n_phi = 193
n_lay = 54

/
